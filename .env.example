# Copy to .env for local development. On Render, add these under Environment.
# Every provider below has a FREE tier. Don't attach billing / buy credits and
# you can never be charged — you just get rate-limited, and BlindCoder fails
# over to the next provider automatically.

# 1) Google Gemini — https://aistudio.google.com/apikey (free, no card)
GEMINI_API_KEY=

# 2) Groq — https://console.groq.com/keys (free, no card, extremely fast)
GROQ_API_KEY=

# 3) Optional last resort: OpenRouter free models — https://openrouter.ai/keys
#    Never buy credits on this key and it stays free.
OPENROUTER_API_KEY=

# Optional tuning (defaults shown)
# AI_PROVIDER_ORDER=gemini,groq,openrouter
# GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-flash-lite-latest
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# OPENROUTER_MODELS=openrouter/free
# ALLOWED_ORIGINS=https://blindcoder.vercel.app,http://localhost:5173
# AI_RATE_PER_MIN=20
# RUN_RATE_PER_MIN=30
